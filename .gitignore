local loadOk, WindUI = pcall(function()
    local req = request or http_request
    if req then
        local r = req({ Url = "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua", Method = "GET" })
        local body = r and (r.Body or r.body)
        if body then
            return loadstring(body)()
        end
    end
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
end)

if not loadOk or not WindUI then return end

getgenv().WindUI = WindUI

local Window = WindUI:CreateWindow({
    Title = "OMEGA HUB",
    Subtitle = "v17 · Ugc",
    Folder = "omegahub",
    Icon = "rbxassetid://0",
    NewElements = true,
})

local Tab1 = Window:Tab({ Title = "主页", Desc = "纯净空壳版", Icon = "rbxassetid://0" })
local Sec1 = Tab1:Section({ Title = "空壳" })

WindUI:Notify({ Title = "OMEGA HUB", Content = "v17 loaded" })
print("[OMEGA] v17 loaded")
